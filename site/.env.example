# Authentification de /admin/* (correction des pages).
#
# En production : le reverse proxy (Nginx Proxy Manager) doit poser cet
# en-tête après avoir authentifié la personne, et l'écraser pour toute valeur
# venant du client (jamais transmis tel quel depuis l'extérieur). Le site
# fait confiance à cet en-tête uniquement parce qu'il est supposé tourner
# derrière ce proxy, jamais exposé directement sur Internet.
AUTH_HEADER=X-Authenticated-User

# En développement uniquement : force l'accès à /admin/* sans proxy devant.
# Ne jamais activer en production.
EDIT_ENABLED=false
# Nom affiché comme auteur des commits de correction quand EDIT_ENABLED=true
# (optionnel, "dev" par défaut).
EDIT_ENABLED_USER=dev
