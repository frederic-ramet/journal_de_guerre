# Développement local (`npm run dev` / `astro dev`) uniquement. En
# production, ces mêmes variables sont dans le .env unique à la racine du
# dépôt (voir .env.example à la racine) : docker compose ne charge jamais ce
# fichier-ci (pas d'env_file sur site/.env dans docker-compose.yml, pour
# éviter d'avoir deux .env à tenir à jour sur le serveur).
#
# Authentification de /admin/* (correction des pages) : JWT Cloudflare Access.
#
# En production : les jetons JWT sont vérifiés avec la signature Cloudflare Access.
# L'identité provient de la réclamation email du jeton. Les jetons sont stateless,
# validés une seule fois à chaque requête (JWKS en cache, clés publiques de
# Cloudflare mises à jour via une URL distante).
#
# Domaine Cloudflare Access de l'organisation (nom nu, sans https://).
# Exemple : le47.cloudflareaccess.com
# Le code construit https://{CF_ACCESS_TEAM_DOMAIN}/cdn-cgi/access/certs
# pour télécharger les clés publiques JWKS.
CF_ACCESS_TEAM_DOMAIN=

# Identifiant d'audience (AUD) de l'application Cloudflare Access (64 caractères).
# Reçu de Cloudflare lors de la configuration de l'application.
CF_ACCESS_AUD=

# Adresses email autorisées à corriger, séparées par des virgules.
# Comparaison insensible à la casse. Vide ou absent : personne ne peut éditer.
# Exemple : alice@example.com, bob@example.com
EDITORS=

# En développement uniquement : force l'accès à /admin/* sans vérification JWT.
# Ne jamais activer en production.
EDIT_ENABLED=false
# Nom affiché comme auteur des commits de correction quand EDIT_ENABLED=true
# (optionnel, "dev" par défaut).
EDIT_ENABLED_USER=dev
