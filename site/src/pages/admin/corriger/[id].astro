---
import Base from '../../../layouts/Base.astro';
import { index } from '../../../lib/index-store';
import { writePageWithGuard, countIncertitudes } from '../../../lib/write-page';
import { commitPageCorrection } from '../../../lib/git-commit';

const { id } = Astro.params;
const page = id ? index.byId(id) : undefined;

if (!page) {
  return new Response('Page introuvable', { status: 404 });
}

const author = Astro.locals.authenticatedUser ?? 'inconnu';

let errorMessage: string | null = null;
let conflictContent: string | null = null;
let successMessage: string | null = null;

// Valeurs affichées dans le formulaire : par défaut celles de la page,
// remplacées par ce que la personne vient de soumettre si la validation échoue
// (pour ne pas lui faire perdre sa saisie).
let formDiplomatique = page.diplomatique;
let formNormalise = page.normalise;
let formDate = page.date ?? '';
let formType = page.type ?? '';
let formSignature = page.signature ?? '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const submittedSha = String(formData.get('sha') ?? '');
  formDiplomatique = String(formData.get('diplomatique') ?? '');
  formNormalise = String(formData.get('normalise') ?? '');
  formDate = String(formData.get('date') ?? '');
  formType = String(formData.get('type') ?? '');
  formSignature = String(formData.get('signature') ?? '');

  if (page.statut === 'verifie_claude') {
    errorMessage =
      'Cette page a le statut "verifie_claude" (relue et validée à la main) : ' +
      'elle ne peut pas être modifiée par ce formulaire.';
  } else {
    const result = writePageWithGuard(
      page,
      {
        diplomatique: formDiplomatique,
        normalise: formNormalise,
        date: formDate.trim() || null,
        type: formType.trim() || null,
        signature: formSignature.trim() || null,
      },
      submittedSha,
    );

    if (result.ok) {
      index.reloadPageSync(page.id);
      commitPageCorrection(page.id, page.filePath, author);
      successMessage = 'Correction enregistrée et commitée.';
    } else if (result.reason === 'conflict') {
      errorMessage =
        'Le fichier a été modifié entre-temps (par un autre correcteur, ou le pipeline de transcription). ' +
        'Rien n\'a été écrasé. Compare avec la version actuelle ci-dessous et réappplique tes changements si besoin.';
      conflictContent = result.currentContent;
    } else if (result.reason === 'locked-status') {
      errorMessage =
        'Cette page a le statut "verifie_claude" sur le fichier actuel : elle ne peut pas être modifiée par ce formulaire.';
    }
  }
}

// Après un succès, on relit la page à jour pour réafficher son état réel
// (nouveau statut, nouvelle empreinte, incertitudes recalculées).
const currentPage = successMessage ? index.byId(page.id)! : page;
const displaySha = successMessage ? currentPage.sha : page.sha;
if (successMessage) {
  formDiplomatique = currentPage.diplomatique;
  formNormalise = currentPage.normalise;
  formDate = currentPage.date ?? '';
  formType = currentPage.type ?? '';
  formSignature = currentPage.signature ?? '';
}

const previewIncertitudes = countIncertitudes(formDiplomatique);
---

<Base title={`Corriger ${page.id}`} active="lire">
  <section class="wrap">
    <p class="folio">Page {page.numero} sur {index.size} — {page.id}</p>
    <h1>Corriger cette page</h1>

    {successMessage && <p class="banner success">{successMessage}</p>}
    {errorMessage && <p class="banner error">{errorMessage}</p>}

    {
      conflictContent && (
        <details class="conflict" open>
          <summary>Voir le contenu actuel du fichier sur disque</summary>
          <pre>{conflictContent}</pre>
        </details>
      )
    }

    <form method="POST">
      <input type="hidden" name="sha" value={displaySha} />

      <div class="field-row">
        <label>
          Date
          <input type="text" name="date" value={formDate} placeholder="1918-06-26 ou null" />
        </label>
        <label>
          Type
          <input type="text" name="type" value={formType} placeholder="journal, lecon, priere..." />
        </label>
        <label>
          Signature
          <input type="text" name="signature" value={formSignature} placeholder="R.E." />
        </label>
      </div>

      <label class="field-block">
        Diplomatique <span class="hint">({previewIncertitudes} [?] — recalculé à l'enregistrement)</span>
        <textarea name="diplomatique" rows="16" class="mono">{formDiplomatique}</textarea>
      </label>

      <label class="field-block">
        Normalisé
        <textarea name="normalise" rows="10">{formNormalise}</textarea>
      </label>

      <button type="submit" class="btn">Enregistrer et commiter</button>
    </form>
  </section>
</Base>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 22px 80px;
  }

  .folio {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 8px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    margin: 0 0 24px;
  }

  .banner {
    padding: 10px 14px;
    border-radius: 2px;
    font-size: 14px;
    margin-bottom: 16px;
  }

  .banner.success {
    background: var(--paper-2);
    border: 1px solid var(--rule-soft);
    color: var(--ink);
  }

  .banner.error {
    background: var(--paper-2);
    border: 1px solid #a65;
    color: var(--ink);
  }

  .conflict {
    margin-bottom: 16px;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 10px 14px;
  }

  .conflict pre {
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 12.5px;
    max-height: 400px;
    overflow-y: auto;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .field-row label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--ink-soft);
    flex: 1;
    min-width: 160px;
  }

  .field-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--rule);
  }

  input,
  textarea {
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
  }

  textarea.mono {
    font-family: var(--font-mono);
    white-space: pre;
  }

  textarea {
    resize: vertical;
  }

  .btn {
    align-self: flex-start;
    font-size: 14px;
    padding: 10px 20px;
    border-radius: 2px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
</style>
