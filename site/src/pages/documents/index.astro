---
import Base from '../../layouts/Base.astro';
import { DOCUMENTS } from '../../data/documents';
---

<Base title="Documents" active="documents">
  <section class="wrap">
    <h1>Documents</h1>
    <p class="lede">Pièces annexes au carnet, sans en faire partie.</p>

    <ul class="doc-list">
      {
        DOCUMENTS.map((doc) => (
          <li>
            <a href={`/documents/${doc.slug}`}>{doc.titre}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 22px 80px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 32px;
    margin: 0 0 8px;
  }

  .lede {
    color: var(--ink-soft);
    margin: 0 0 32px;
  }

  .doc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .doc-list li {
    border-bottom: 1px solid var(--line);
  }

  .doc-list a {
    display: block;
    padding: 16px 4px;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
  }

  .doc-list a:hover {
    color: var(--rule);
  }
</style>
